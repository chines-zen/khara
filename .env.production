# Production Environment Variables
# Copy these to your deployment platform (Cloud Run, Kubernetes, etc.)

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=zendesk-global
# SNOWFLAKE_USERNAME is not needed - EXTERNALBROWSER auth uses SSO via Pomerium
SNOWFLAKE_WAREHOUSE=PUBLIC_ZENDESK_XS
SNOWFLAKE_DATABASE=FOUNDATIONAL
SNOWFLAKE_SCHEMA=CUSTOMER
SNOWFLAKE_ROLE=PUBLIC

# Google Cloud / Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=it-ai-exploration
GOOGLE_CLOUD_LOCATION=global

# PostgreSQL Database Configuration
# These should be set by your deployment platform or point to Cloud SQL
DB_HOST=<your-production-db-host>
DB_PORT=5432
DB_NAME=khara
DB_USER=<your-production-db-user>
DB_PASSWORD=<your-production-db-password>

# Session Configuration
SESSION_SECRET=<generate-a-new-secure-random-string-for-production>
SESSION_MAX_AGE_MS=86400000

# Production Mode
DEV_MODE=false

# Show the "Do Not Click" button on Advanced Settings (true = shown, false = hidden)
DO_NOT_CLICK_ACTIVE=false

# Optional: CORS Configuration
# CORS_ORIGIN=https://your-frontend-domain.com
