# Snowflake Configuration
# Copy this file to .env and fill in your Snowflake credentials

# Your Snowflake account identifier (e.g., xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=

# Snowflake username
SNOWFLAKE_USERNAME=

# Snowflake password
SNOWFLAKE_PASSWORD=

# Snowflake warehouse to use for compute
SNOWFLAKE_WAREHOUSE=

# Snowflake database name
SNOWFLAKE_DATABASE=

# Snowflake schema name
SNOWFLAKE_SCHEMA=

# Snowflake role (optional, defaults to user's default role)
SNOWFLAKE_ROLE=

# Local testing only: authenticate the EXTERNALBROWSER SSO as this fixed identity
# regardless of the app-user's email (DEV_USER_EMAIL / dev session-email). Lets you
# test another SE's in-app experience under your own Snowflake access without their
# SSO. The browser pops once; switching the app-level SC just re-scopes the query.
# LEAVE UNSET IN PRODUCTION so each user authenticates under their own identity/RBAC.
# SNOWFLAKE_AUTH_USER=your_email@zendesk.com

# Return static mock data instead of querying Snowflake (set false when Snowflake is back)
USE_MOCK_DATA=true

# Bypass SC identity/stage/ARR/close-date scoping and always return the fixed
# TEST_OPP_IDS set from services/test-opps.js (for local dev only)
USE_TEST_OPPS=false

# Show the Activities tab (requires SA_ACTIVITY_DAILY_SNAPSHOT access in Snowflake)
ACTIVITIES_ENABLED=false

# Show the "Do Not Click" button on Advanced Settings (true = shown, false = hidden)
DO_NOT_CLICK_ACTIVE=true

# Zendesk internal AI gateway (Bedrock-compatible, bearer-token authenticated)
# used to generate opportunity summaries via Claude
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=https://ai-gateway.zende.sk/bedrock
AWS_BEARER_TOKEN_BEDROCK=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=se_opp_rigor
DB_USER=postgres
DB_PASSWORD=

# Session Configuration
SESSION_SECRET=change-this-to-a-long-random-string-in-production
SESSION_MAX_AGE_MS=86400000  # 24 hours in milliseconds

# Development Mode (bypasses authentication for local testing)
# WARNING: Set to 'false' in production!
DEV_MODE=true

# Development User Email (only used when DEV_MODE=true)
# Optional: pre-set this to skip the first-use email capture dialog.
# If unset, the app will prompt for your email on first load and use it
# to authenticate to Snowflake via EXTERNALBROWSER SSO (a browser window
# will open) when SNOWFLAKE_USERNAME/SNOWFLAKE_PASSWORD aren't set below.
# DEV_USER_EMAIL=your_email@zendesk.com
