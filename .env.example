# Copy this file to .env and fill in the blanks (secrets / personal identity).
# The non-secret defaults below are the working Zendesk values — adjust as needed.

# Snowflake Configuration (uses defaults from snowflake-connection.js)
SNOWFLAKE_ACCOUNT=zendesk-global
# SNOWFLAKE_USERNAME/PASSWORD are optional. Leave unset to use EXTERNALBROWSER
# SSO (a browser window opens on first query). Set both only for password auth.
# SNOWFLAKE_USERNAME=
# SNOWFLAKE_PASSWORD=
# Local testing only: authenticate the Snowflake SSO browser as this fixed
# identity regardless of the app-user's email (DEV_USER_EMAIL / dev session).
# Lets you test a new SE's experience under your own Snowflake access — the
# browser pops once, and switching the app-level SC just re-scopes the data.
# LEAVE UNSET IN PRODUCTION so each user authenticates under their own identity.
# SNOWFLAKE_AUTH_USER=your_email@zendesk.com
SNOWFLAKE_WAREHOUSE=PUBLIC_ZENDESK_XS
SNOWFLAKE_DATABASE=FOUNDATIONAL
SNOWFLAKE_SCHEMA=CUSTOMER
SNOWFLAKE_ROLE=PUBLIC

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=se_opp_rigor
DB_USER=postgres
DB_PASSWORD=

# Session Configuration
SESSION_SECRET=change-this-to-a-long-random-string-in-production
SESSION_MAX_AGE_MS=86400000  # 24 hours in milliseconds

# Bypass SC identity/stage/ARR/close-date scoping and always return the fixed
# TEST_OPP_IDS set from services/test-opps.js (for local dev only)
USE_TEST_OPPS=false

# Show the Activities tab (requires SA_ACTIVITY_DAILY_SNAPSHOT access in Snowflake)
ACTIVITIES_ENABLED=false

# Show the "Do Not Click" button on Advanced Settings (true = shown, false = hidden)
DO_NOT_CLICK_ACTIVE=true

# Development Mode (bypasses Pomerium authentication)
# IMPORTANT: Set to false in production!
DEV_MODE=true

# DEV_USER_EMAIL is only used when DEV_MODE=true.
# Optional: pre-set this to skip the first-use email capture dialog. If unset,
# the app prompts for your email on first load and uses it to authenticate to
# Snowflake via EXTERNALBROWSER SSO when SNOWFLAKE_USERNAME/PASSWORD aren't set.
# DEV_USER_EMAIL=your_email@zendesk.com

# Zendesk internal AI gateway (Bedrock-compatible) — used to generate opportunity summaries
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=https://ai-gateway.zende.sk/bedrock
AWS_BEARER_TOKEN_BEDROCK=
