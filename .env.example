# Snowflake Configuration
# Copy this file to .env and fill in your Snowflake credentials

# Your Snowflake account identifier (e.g., xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=

# Snowflake username
SNOWFLAKE_USERNAME=

# Snowflake password
SNOWFLAKE_PASSWORD=

# Snowflake warehouse to use for compute
SNOWFLAKE_WAREHOUSE=

# Snowflake database name
SNOWFLAKE_DATABASE=

# Snowflake schema name
SNOWFLAKE_SCHEMA=

# Snowflake role (optional, defaults to user's default role)
SNOWFLAKE_ROLE=

# Google Cloud / Vertex AI Configuration
# For Cloud Run: These are automatically set via service account
# For local development: Use `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=it-ai-exploration
GOOGLE_CLOUD_LOCATION=global

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=se_opp_rigor
DB_USER=postgres
DB_PASSWORD=

# Session Configuration
SESSION_SECRET=change-this-to-a-long-random-string-in-production
SESSION_MAX_AGE_MS=86400000  # 24 hours in milliseconds

# Development Mode (bypasses authentication for local testing)
# WARNING: Set to 'false' in production!
DEV_MODE=true

# Development User Email (only used when DEV_MODE=true)
# Set this to your Zendesk email for local testing
DEV_USER_EMAIL=your-email@zendesk.com
